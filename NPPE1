    self.records = dataframe.reset_index(drop=True)\n        self.transform = transform\n        self.is_test = is_test\n\n    def __len__(self):\n        return len(self.records)\n\n    def __getitem__(self, index):\n        img_path = self.records.loc[index, \"image_path\"]\n        if os.path.exists(img_path):\n            img = Image.open(img_path).convert(\"RGB\")\n        else:\n            img = Image.new(\"RGB\", (224, 224), color=(128, 128, 128))\n\n        if self.transform is not None:\n            img = self.transform(img)\n\n        if self.is_test:\n            item_id = self.records.loc[index, \"id\"]\n            return img, item_id\n\n        label_joint = self.records.loc[index, \"label\"]\n        label_material = self.records.loc[index, \"material_label\"]\n        label_condition = self.records.loc[index, \"condition_label\"]\n\n        return (\n            img,\n            torch.tensor(label_joint, dtype=torch.long),\n            torch.tensor(label_material, dtype=torch.long),\n            torch.tensor(label_condition, dtype=torch.long)\n        )\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T08:06:46.321447Z","iopub.execute_input":"2026-11-24T08:06:46.321831Z","iopub.status.idle":"2026-11-24T08:06:46.332149Z","shell.execute_reply.started":"2026-11-24T08:06:46.321807Z","shell.execute_reply":"2026-11-24T08:06:46.331402Z"}},"outputs":[],"execution_count":4},{"cell_type":"markdown","source":"## 5. Multi-Task Deep Neural Network Architecture\n\nInitialize a deep convolutional network from scratch. Three classification projections share a common latent representation, guiding the model toward invariant material and damage properties.","metadata":{}},{"cell_type":"code","source":"class MultiTaskResNet(nn.Module):\n    def __init__(self, num_classes=20, num_materials=10, num_conditions=2):\n        super().__init__()\n        backbone = resnet34(weights=None)\n        features_dim = backbone.fc.in_features\n        self.encoder = nn.Sequential(*list(backbone.children())[:-1])\n        self.dropout = nn.Dropout(p=0.3)\n        self.fc_joint = nn.Linear(features_dim, num_classes)\n        self.fc_material = nn.Linear(features_dim, num_materials)\n        self.fc_condition = nn.Linear(features_dim, num_conditions)\n        self.apply_initialization()\n\n    def apply_initialization(self):\n        for head in [self.fc_joint, self.fc_material, self.fc_condition]:\n            nn.init.kaiming_normal_(head.weight, mode=\"fan_out\", nonlinearity=\"relu\")\n            nn.init.constant_(head.bias, 0.0)\n\n    def forward(self, x):\n        feat = self.encoder(x)\n        feat = torch.flatten(feat, 1)\n        feat = self.dropout(feat)\n        out_joint = self.fc_joint(feat)\n        out_mat = self.fc_material(feat)\n        out_cond = self.fc_condition(feat)\n        return out_joint, out_mat, out_cond\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T08:06:46.333285Z","iopub.execute_input":"2026-11-24T08:06:46.333607Z","iopub.status.idle":"2026-11-24T08:06:46.350079Z","shell.execute_reply.started":"2026-11-24T08:06:46.333573Z","shell.execute_reply":"2026-11-24T08:06:46.34945Z"}},"outputs":[],"execution_count":5},{"cell_type":"markdown","source":"## 6. Regularized Multi-Task Loss Objective\n\nIntegrate label-smoothed cross entropy on the full joint distribution with cross entropy on both material and condition tasks.","metadata":{}},{"cell_type":"code","source":"class MultiTaskObjective(nn.Module):\n    def __init__(self, smoothing=0.1, mat_weight=0.5, cond_weight=0.5):\n        super().__init__()\n        self.joint_loss = nn.CrossEntropyLoss(label_smoothing=smoothing)\n        self.mat_loss = nn.CrossEntropyLoss()\n        self.cond_loss = nn.CrossEntropyLoss()\n        self.mat_weight = mat_weight\n        self.cond_weight = cond_weight\n\n    def forward(self, logits_j, logits_m, logits_c, target_j, target_m, target_c):\n        loss_j = self.joint_loss(logits_j, target_j)\n        loss_m = self.mat_loss(logits_m, target_m)\n        loss_c = self.cond_loss(logits_c, target_c)\n        combined = loss_j + self.mat_weight * loss_m + self.cond_weight * loss_c\n        return combined\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T08:06:46.35125Z","iopub.execute_input":"2026-11-24T08:06:46.351982Z","iopub.status.idle":"2026-11-24T08:06:46.370386Z","shell.execute_reply.started":"2026-11-24T08:06:46.351943Z","shell.execute_reply":"2026-11-24T08:06:46.369649Z"}},"outputs":[],"execution_count":6},{"cell_type":"markdown","source":"## 7. Model Training and Macro F1 Evaluation Logic\n\nTrain across mini-batches, apply gradient clipping, and score validation iterations with exact macro-averaged F1.","metadata":{}},{"cell_type":"code","source":"def run_epoch_train(model, loader, loss_fn, optimizer, scheduler, current_device):\n    model.train()\n    cumulative_loss = 0.0\n    for imgs, tj, tm, tc in loader:\n        imgs = imgs.to(current_device)\n        tj = tj.to(current_device)\n        tm = tm.to(current_device)\n        tc = tc.to(current_device)\n\n        optimizer.zero_grad()\n        out_j, out_m, out_c = model(imgs)\n        loss = loss_fn(out_j, out_m, out_c, tj, tm, tc)\n        loss.backward()\n        nn.utils.clip_grad_norm_(model.parameters(), max_norm=5.0)\n        optimizer.step()\n        cumulative_loss += loss.item() * imgs.size(0)\n\n    scheduler.step()\n    return cumulative_loss / len(loader.dataset)\n\ndef run_epoch_eval(model, loader, loss_fn, current_device):\n    model.eval()\n    cumulative_loss = 0.0\n    all_true = []\n    all_pred = []\n\n    with torch.no_grad():\n        for imgs, tj, tm, tc in loader:\n            imgs = imgs.to(current_device)\n            tj = tj.to(current_device)\n            tm = tm.to(current_device)\n            tc = tc.to(current_device)\n\n            out_j, out_m, out_c = model(imgs)\n            loss = loss_fn(out_j, out_m, out_c, tj, tm, tc)\n            cumulative_loss += loss.item() * imgs.size(0)\n\n            prob_j = torch.softmax(out_j, dim=1)\n            prob_m = torch.softmax(out_m, dim=1)\n            prob_c = torch.softmax(out_c, dim=1)\n\n            prob_factor = torch.zeros_like(prob_j)\n            for m_idx in range(10):\n                for c_idx in range(2):\n                    target_index = 2 * m_idx + c_idx\n                    prob_factor[:, target_index] = prob_m[:, m_idx] * prob_c[:, c_idx]\n\n            blended_prob = 0.6 * prob_j + 0.4 * prob_factor\n            preds = torch.argmax(blended_prob, dim=1)\n\n            all_true.extend(tj.cpu().numpy())\n            all_pred.extend(preds.cpu().numpy())\n\n    val_loss = cumulative_loss / len(loader.dataset)\n    macro_f1 = f1_score(all_true, all_pred, average=\"macro\", zero_division=0)\n    return val_loss, macro_f1\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T08:06:46.372766Z","iopub.execute_input":"2026-11-24T08:06:46.373104Z","iopub.status.idle":"2026-11-24T08:06:46.391378Z","shell.execute_reply.started":"2026-11-24T08:06:46.373083Z","shell.execute_reply":"2026-11-24T08:06:46.390717Z"}},"outputs":[],"execution_count":7},{"cell_type":"markdown","source":"## 8. Stratified Partitioning and Optimization Cycle\n\nTrain model weights from scratch with Cosine Annealing learning rate schedule and AdamW weight decay, retaining the checkpoint with peak Macro F1.","metadata":{}},{"cell_type":"code","source":"splitter = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\ntrain_idx, val_idx = next(splitter.split(train_df, train_df[\"label\"]))\n\ndf_train = train_df.iloc[train_idx].reset_index(drop=True)\ndf_val = train_df.iloc[val_idx].reset_index(drop=True)\n\nbatch_sz = 64\nworkers = 2 if torch.cuda.is_available() else 0\n\nds_train = MaterialDefectDataset(df_train, transform=train_transforms)\nds_val = MaterialDefectDataset(df_val, transform=eval_transforms)\n\ndl_train = DataLoader(ds_train, 