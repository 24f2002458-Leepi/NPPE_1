6-11-24T08:06:42.931687Z","shell.execute_reply.started":"2026-11-24T08:06:38.367653Z","shell.execute_reply":"2026-11-24T08:06:42.93102Z"}},"outputs":[{"name":"stdout","text":"Loaded train samples: 9908\nLoaded test samples: 3325\n","output_type":"stream"}],"execution_count":2},{"cell_type":"markdown","source":"## 3. Image Indexing and Label Decomposition\n\nResolve file locations for image IDs across multiple extensions and factor the target into independent material and defect labels.","metadata":{}},{"cell_type":"code","source":"def index_image_paths(folders):\n    path_map = {}\n    valid_exts = {\".jpg\", \".jpeg\", \".png\", \".webp\", \".bmp\"}\n    for folder in folders:\n        if os.path.exists(folder):\n            for item in os.scandir(folder):\n                if item.is_file():\n                    base, ext = os.path.splitext(item.name)\n                    if ext.lower() in valid_exts:\n                        path_map[base] = item.path\n    return path_map\n\nimage_map = index_image_paths(image_folders)\n\ndef resolve_path(img_id, cache, dirs):\n    if img_id in cache:\n        return cache[img_id]\n    for d in dirs:\n        for ext in [\".jpg\", \".png\", \".jpeg\", \".webp\"]:\n            p = os.path.join(d, f\"{img_id}{ext}\")\n            if os.path.exists(p):\n                cache[img_id] = p\n                return p\n    for ext in [\".jpg\", \".png\"]:\n        p = f\"{img_id}{ext}\"\n        if os.path.exists(p):\n            return p\n    return f\"{img_id}.jpg\"\n\ntrain_df[\"image_path\"] = train_df[\"id\"].apply(lambda x: resolve_path(x, image_map, image_folders))\ntest_df[\"image_path\"] = test_df[\"id\"].apply(lambda x: resolve_path(x, image_map, image_folders))\n\ntrain_df[\"material_label\"] = train_df[\"label\"] // 2\ntrain_df[\"condition_label\"] = train_df[\"label\"] % 2\n\nprint(train_df.head())\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-24T08:06:42.932523Z","iopub.execute_input":"2026-11-24T08: